{
  "version": 1,
  "presets": {
    "success": {
      "scenario": "success"
    },
    "empty": {
      "scenario": "empty"
    },
    "unconfigured": {
      "scenario": "unconfigured"
    },
    "error": {
      "scenario": "error"
    },
    "model-connections": {
      "scenario": "success",
      "cases": {
        "agent.secret.provider-list": "versioned-empty",
        "agent.secret.provider-configure": "connection-configured",
        "agent.secret.provider-test": "saved-connection-replied"
      }
    },
    "model-connections-saved": {
      "scenario": "success",
      "cases": {
        "agent.secret.provider-list": "versioned-connection",
        "agent.secret.provider-configure": "connection-rotated",
        "agent.secret.provider-test": "saved-connection-replied"
      }
    },
    "model-connections-rotated": {
      "scenario": "success",
      "cases": {
        "agent.secret.provider-list": "versioned-rotated",
        "agent.secret.provider-configure": "connection-conflict",
        "agent.secret.provider-test": "saved-connection-replied"
      }
    },
    "agent-model-create": {
      "scenario": "success",
      "cases": {
        "agent.secret.provider-list": "versioned-connection",
        "agent.provider.auth.list": "empty",
        "agent.list": "empty-registry",
        "agent.create": "manual-model-created",
        "agent.model.status": "manual-connection",
        "org.list": "no-joined-orgs"
      }
    },
    "agent-model-saved": {
      "scenario": "success",
      "cases": {
        "agent.secret.provider-list": "versioned-connection",
        "agent.provider.auth.list": "empty",
        "agent.list": "manual-model-agent",
        "agent.model.status": "manual-connection",
        "agent.start": "running-evidenced",
        "org.list": "no-joined-orgs"
      }
    },
    "agent-model-pending": {
      "scenario": "success",
      "cases": {
        "agent.secret.provider-list": "versioned-connection",
        "agent.provider.auth.list": "empty",
        "agent.list": "manual-model-agent",
        "agent.model.status": "pending-connection",
        "agent.model.cancel": "cancel-manual-connection",
        "org.list": "no-joined-orgs"
      }
    },
    "agent-model-cancelled": {
      "scenario": "success",
      "cases": {
        "agent.secret.provider-list": "versioned-connection",
        "agent.provider.auth.list": "empty",
        "agent.list": "manual-model-agent",
        "agent.model.status": "read-back",
        "org.list": "no-joined-orgs"
      }
    }
  },
  "transitions": [
    {
      "preset": "model-connections",
      "method": "agent.secret.provider-configure",
      "next": "model-connections-saved"
    },
    {
      "preset": "model-connections-saved",
      "method": "agent.secret.provider-configure",
      "next": "model-connections-rotated"
    },
    {
      "preset": "agent-model-create",
      "method": "agent.create",
      "next": "agent-model-saved"
    },
    {
      "preset": "agent-model-pending",
      "method": "agent.model.cancel",
      "next": "agent-model-cancelled"
    }
  ],
  "inputGuards": [
    {
      "method": "agent.provider.login",
      "requireOneOf": [
        {
          "path": [
            "setupToken"
          ],
          "equals": "example-not-a-credential"
        },
        {
          "path": [
            "files",
            "*",
            "contentBase64"
          ],
          "equals": "ZXhhbXBsZS1ub3QtYS1jcmVkZW50aWFs"
        }
      ],
      "refusal": {
        "code": "INVALID_ARGUMENT",
        "message": "mock login accepts only the documented synthetic sentinel"
      }
    }
  ]
}
