FROM ghcr.io/astral-sh/uv:0.8.15 AS uv

FROM node:24-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/
RUN useradd --uid 10001 --create-home hyprial \
    && mkdir -p /opt/hyprial/source \
    && chown 10001:10001 /opt/hyprial/source
WORKDIR /opt/hyprial/source
COPY --chown=10001:10001 . /opt/hyprial/source/
USER 10001

RUN git init -q \
    && git config user.email gui-debug@example.invalid \
    && git config user.name 'GUI debug' \
    && git add . \
    && git commit -qm 'isolated GUI debug source'
RUN HYPRIAL_BUILD_SKIP_NATIVE=1 uv sync --frozen --no-dev --python 3.12
RUN npm --prefix gui ci --ignore-scripts

EXPOSE 4174
ENTRYPOINT ["/opt/hyprial/source/scripts/build/docker/gui-debug-container-entrypoint.sh"]
