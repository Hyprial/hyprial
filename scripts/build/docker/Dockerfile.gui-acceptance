FROM --platform=$BUILDPLATFORM golang:1.27.1 AS tailcat
ARG TARGETARCH
ARG GOPROXY=""
WORKDIR /src
COPY sidecar/hyprial-tailcat/go.mod sidecar/hyprial-tailcat/go.sum ./
RUN [ -z "${GOPROXY}" ] || go env -w GOPROXY="${GOPROXY}"; go mod download
COPY sidecar/hyprial-tailcat/cmd ./cmd
COPY sidecar/hyprial-tailcat/internal ./internal
RUN set -e; \
    engine="$(awk '$1 == "github.com/tailscale/tailcat" { print $2 }' go.mod)"; \
    test -n "$engine"; \
    grep -q "TailcatCommit = \"${engine##*-}" internal/buildinfo/buildinfo.go
RUN CGO_ENABLED=0 GOOS=linux GOARCH="${TARGETARCH}" \
    go build -trimpath -ldflags='-s -w' -o /out/hyprial-tailcat ./cmd/hyprial-tailcat

FROM ghcr.io/astral-sh/uv:0.8.15 AS uv

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/
RUN useradd --uid 10001 --create-home hyprial \
    && mkdir -p /opt/hyprial/source \
    && chown 10001:10001 /opt/hyprial/source
WORKDIR /opt/hyprial/source
COPY --chown=10001:10001 . /opt/hyprial/source/
USER 10001
RUN git init -q \
    && git config user.email gui-acceptance@example.invalid \
    && git config user.name 'GUI acceptance' \
    && git add . \
    && git commit -qm 'isolated GUI acceptance source'
RUN HYPRIAL_BUILD_SKIP_NATIVE=1 uv sync --frozen --no-dev --python 3.12
RUN npm --prefix gui ci --ignore-scripts
COPY --from=tailcat --chown=10001:10001 /out/hyprial-tailcat \
    /opt/hyprial/source/src/hyprial/_bin/hyprial-tailcat
RUN .venv/bin/python -c 'from pathlib import Path; from hyprial.daemon.impl.network.tailcat.binary import verify_tailcat_sidecar; print(verify_tailcat_sidecar(Path("/tmp/unused")))'

EXPOSE 4174
ENTRYPOINT ["/opt/hyprial/source/scripts/build/docker/gui-debug-container-entrypoint.sh"]
