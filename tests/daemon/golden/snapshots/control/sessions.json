   "method": "session.turn.refresh",
   "label": "schema",
   "origin": "ipc",
   "params": {
    "actor": "alpha",
    "sessionRef": "session-alpha",
    "schemaVersion": 2
   },
   "error": {
    "code": "INVALID_ARGUMENT",
    "message": "session.turn.refresh params do not match the declared schema at <root>"
   }
  },
  {
   "step": 8,
   "method": "session.turn.started",
   "label": "missing-report-id",
   "origin": "ipc",
   "params": {
    "actor": "alpha",
    "sessionRef": "session-alpha"
   },
   "error": {
    "code": "INVALID_ARGUMENT",
    "message": "reportId must be a non-empty string"
   }
  },
  {
   "step": 9,
   "method": "session.heartbeat",
   "label": "stale",
   "origin": "ipc",
   "params": {
    "actor": "alpha",
    "sessionRef": "session-bogus"
   },
   "error": {
    "code": "SESSION_SUPERSEDED",
    "message": "actor agent:op:node-1:alpha is now owned by another interactive session"
