    "applied": false,
    "resyncCleared": false,
    "observationGapCleared": false,
    "rejectionReason": "stale_daemon_epoch"
   }
  },
  {
   "step": 6,
   "method": "session.turn.refresh",
   "label": "current-epoch",
   "origin": "ipc",
   "params": {
    "actor": "alpha",
    "sessionRef": "session-alpha",
    "schemaVersion": 1,
    "producerEpoch": "producer-1",
    "seq": 2,
    "daemonEpoch": "<uuid4#1>",
    "openRuns": [],
    "capabilities": {
     "wholeSessionTurns": true,
     "preparation": false,
     "permissionWait": false,
     "producerActivity": false
    }
   },
   "result": {
    "ok": true,
    "schemaVersion": 1,
    "refreshedAtMs": 1800000000000,
    "applied": true,
    "resyncCleared": false,
    "observationGapCleared": false,
    "rejectionReason": null
