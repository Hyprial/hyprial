    "sessionRef": "session-alpha"
   },
   "result": {
    "ok": true,
    "alive": true,
    "unregistered": false,
    "actor": "agent:op:node-1:alpha",
    "sessionRef": "session-alpha",
    "daemonEpoch": "<uuid4#1>",
    "observationGap": false
   }
  },
  {
   "step": 2,
   "method": "session.refresh",
   "origin": "ipc",
   "params": {
    "actor": "alpha",
    "sessionRef": "session-alpha"
   },
   "result": {
    "ok": true,
    "refreshed": true,
    "unregistered": false,
    "actor": "agent:op:node-1:alpha",
    "sessionRef": "session-alpha",
