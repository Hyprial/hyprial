  },
  {
   "step": 10,
   "method": "session.register",
   "label": "same-session",
   "origin": "ipc",
   "params": {
    "actor": "alpha",
    "sessionRef": "session-alpha",
    "cwd": "<tmp>/work",
    "command": [
     "golden-carrier"
    ],
    "source": "claude-channel",
    "runtime": "claude_interactive"
   },
   "result": {
    "ok": true,
    "registered": true,
    "unregistered": false,
    "actor": "agent:op:node-1:alpha",
    "sessionRef": "session-alpha",
    "channelCurrentThisGeneration": true,
    "channelCurrentEpoch": "<uuid4#1>",
    "daemonEpoch": "<uuid4#1>"
   }
  },
  {
   "step": 11,
   "method": "session.register",
   "label": "supersede",
   "origin": "ipc",
   "params": {
    "actor": "alpha",
    "sessionRef": "session-alpha-2",
    "cwd": "<tmp>/work",
    "command": [
     "golden-carrier"
    ],
    "source": "claude-channel",
    "runtime": "claude_interactive"
   },
   "result": {
    "ok": true,
    "registered": true,
    "unregistered": false,
    "actor": "agent:op:node-1:alpha",
    "sessionRef": "session-alpha-2",
    "channelCurrentThisGeneration": true,
    "channelCurrentEpoch": "<uuid4#1>",
    "daemonEpoch": "<uuid4#1>"
   }
  },
  {
   "step": 12,
   "method": "session.heartbeat",
   "label": "superseded",
   "origin": "ipc",
   "params": {
    "actor": "alpha",
    "sessionRef": "session-alpha"
   },
   "error": {
    "code": "SESSION_SUPERSEDED",
    "message": "actor agent:op:node-1:alpha is now owned by another interactive session"
   }
  },
  {
   "step": 13,
   "method": "session.register_guarded",
   "label": "guarded-reclaim",
   "origin": "ipc",
   "params": {
    "actor": "alpha",
    "sessionRef": "session-alpha",
    "cwd": "<tmp>/work",
    "command": [
     "golden-carrier"
    ],
    "source": "claude-channel",
    "runtime": "claude_interactive"
   },
   "error": {
    "code": "AGENT_ALREADY_RUNNING",
    "message": "agent agent:op:node-1:alpha already has a live connector on claude (interactive, session session-alpha-2); hyprial agent start will not attach to a running agent. To move it to claude, stop the current connector first — exit that session — then start it again. This is not a name conflict: it stays the same agent with the same identity, and its previous harness and session id are reported on the next start so you can restore that conversation by hand.",
    "data": {
     "actor": "agent:op:node-1:alpha",
     "existing": {
      "actor": "agent:op:node-1:alpha",
      "harness": "claude",
      "runtime": "interactive",
      "sessionId": "session-alpha-2",
      "boundAtMs": 1800000000000
     },
     "requestedHarness": "claude",
     "requestedRuntime": "interactive"
    }
   }
  },
  {
   "step": 14,
   "method": "session.register_guarded",
   "label": "guarded-unknown-agent",
   "origin": "ipc",
   "params": {
    "actor": "delta",
    "sessionRef": "session-delta",
    "cwd": "<tmp>/work",
    "command": [
     "golden-carrier"
    ],
    "source": "claude-channel",
    "runtime": "claude_interactive"
   },
   "error": {
    "code": "AGENT_NOT_FOUND",
    "message": "no agent named 'agent:op:node-1:delta' on this machine"
   }
  },
  {
   "step": 15,
   "method": "session.unregister",
   "origin": "ipc",
   "params": {
    "actor": "beta",
    "sessionRef": "session-beta"
   },
   "result": {
    "ok": true,
    "unregistered": true,
    "actor": "agent:op:node-1:beta",
    "sessionRef": "session-beta"
   }
  },
  {
   "step": 16,
   "method": "session.heartbeat",
   "label": "after-unregister",
   "origin": "ipc",
   "params": {
    "actor": "beta",
    "sessionRef": "session-beta"
   },
   "error": {
    "code": "STALE_SESSION",
    "message": "interactive session session-beta no longer owns actor agent:op:node-1:beta"
   }
  },
  {
   "step": 17,
   "method": "session.unregister",
   "label": "repeat",
   "origin": "ipc",
   "params": {
    "actor": "beta",
    "sessionRef": "session-beta"
   },
   "result": {
    "ok": true,
    "unregistered": false,
    "actor": "agent:op:node-1:beta",
    "sessionRef": "session-beta"
   }
  },
  {
   "step": 18,
   "method": "session.register",
   "label": "missing-fields",
   "origin": "ipc",
   "params": {
    "actor": "gamma"
   },
   "error": {
    "code": "INVALID_ARGUMENT",
    "message": "sessionRef must be a non-empty string"
   }
  },
  {
   "step": 19,
   "method": "session.register_guarded",
   "label": "guarded-after-unregister",
   "origin": "ipc",
   "params": {
    "actor": "beta",
    "sessionRef": "session-beta-2",
    "cwd": "<tmp>/work",
    "command": [
     "golden-carrier"
    ],
    "source": "claude-channel",
    "runtime": "claude_interactive"
   },
   "result": {
    "ok": true,
    "registered": true,
    "unregistered": false,
    "actor": "agent:op:node-1:beta",
    "sessionRef": "session-beta-2",
    "channelCurrentThisGeneration": true,
    "channelCurrentEpoch": "<uuid4#1>",
    "daemonEpoch": "<uuid4#1>",
    "liveIncumbentGuardApplied": true
   }
  },
  {
   "step": 20,
   "method": "session.heartbeat",
   "label": "after-guarded-register",
   "origin": "ipc",
   "params": {
    "actor": "beta",
    "sessionRef": "session-beta-2"
   },
   "result": {
    "ok": true,
    "alive": true,
    "unregistered": false,
    "actor": "agent:op:node-1:beta",
    "sessionRef": "session-beta-2",
    "daemonEpoch": "<uuid4#1>",
    "observationGap": false
   }
  }
 ]
