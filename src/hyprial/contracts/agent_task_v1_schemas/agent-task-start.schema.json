{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hyprial.com/mfu/h2b-agent-task/v1/agent-task-start.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "namespace", "externalRef", "requestDigest", "metadata", "payload", "targets", "completion"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "namespace": { "const": "mfu.agent-task.v1" },
    "externalRef": {
      "type": "string", "minLength": 7, "maxLength": 240,
      "pattern": "^mfu:[^:\\s]+:[^:\\s]+:[^:\\s]+$"
    },
    "requestDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "metadata": { "type": "object", "maxProperties": 32 },
    "payload": { "$ref": "mfu-work-package.schema.json" },
    "targets": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": { "$ref": "common.schema.json#/$defs/targetInput" }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "result.submitted" } }
    }
  }
}
