{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hyprial.com/mfu/hyprial-agent-task/v1/mfu-work-package.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "businessCaseId", "businessCaseReference", "workItemId", "attemptId", "objective", "workPackage", "owner", "participants", "reworkFeedback"],
  "properties": {
    "schemaVersion": { "const": "mfu.work-package/v1" },
    "businessCaseId": { "type": "string", "minLength": 1, "maxLength": 240 },
    "businessCaseReference": { "type": "string", "minLength": 1, "maxLength": 240 },
    "workItemId": { "type": "string", "minLength": 1, "maxLength": 240 },
    "attemptId": { "type": "string", "minLength": 1, "maxLength": 240 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2400 },
    "owner": { "$ref": "common.schema.json#/$defs/agentUri" },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/agentUri" }
    },
    "reworkFeedback": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 2000 },
        { "type": "null" }
      ]
    },
    "workPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "inputContext", "expectedDeliverables", "acceptanceCriteria", "constraints", "collaborationInstructions", "workspace", "confirmedAt"],
      "properties": {
        "instructions": { "type": "string", "minLength": 1, "maxLength": 2400 },
        "inputContext": { "type": "string", "maxLength": 1600 },
        "expectedDeliverables": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "acceptanceCriteria": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "constraints": {
          "type": "array", "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "collaborationInstructions": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "confirmedAt": { "$ref": "common.schema.json#/$defs/instant" },
        "workspace": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reason"],
              "properties": {
                "kind": { "const": "none" },
                "reason": { "type": "string", "minLength": 1, "maxLength": 600 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "remoteUrl", "baseRef", "baseCommit", "targetBranch", "allowedPaths", "knowledgeSources", "requiredChecks", "deliveryMode"],
              "properties": {
                "kind": { "const": "git" },
                "remoteUrl": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^(https://|ssh://git@)" },
                "baseRef": { "type": "string", "minLength": 1, "maxLength": 240 },
                "baseCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
                "targetBranch": { "type": "string", "minLength": 1, "maxLength": 240 },
                "allowedPaths": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 400, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" } },
                "knowledgeSources": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
                "requiredChecks": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
                "deliveryMode": { "enum": ["commit", "pull_request"] }
              }
            }
          ]
        }
      }
    }
  }
}
