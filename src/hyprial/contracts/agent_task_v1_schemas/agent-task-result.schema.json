{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hyprial.com/mfu/h2b-agent-task/v1/agent-task-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "externalRef", "targets"],
  "properties": {
    "runId": { "$ref": "common.schema.json#/$defs/boundedId" },
    "externalRef": { "type": "string", "minLength": 7, "maxLength": 240 },
    "targets": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["targetRef", "target", "conversationId", "attempts", "state", "resultRef", "result"],
        "properties": {
          "targetRef": { "$ref": "common.schema.json#/$defs/targetRef" },
          "target": { "$ref": "common.schema.json#/$defs/agentUri" },
          "conversationId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/boundedId" }, { "type": "null" }] },
          "attempts": { "type": "integer", "minimum": 0 },
          "state": { "enum": ["reserved", "dispatching", "running", "waiting", "completed", "failed", "cancelled"] },
          "resultRef": { "oneOf": [{ "$ref": "common.schema.json#/$defs/boundedId" }, { "type": "null" }] },
              "result": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object", "additionalProperties": false,
                    "required": ["resultRef", "messageId", "payload", "artifacts", "submittedAt"],
                    "properties": {
                      "resultRef": { "$ref": "common.schema.json#/$defs/boundedId" },
                      "messageId": { "$ref": "common.schema.json#/$defs/boundedId" },
                      "payload": { "$ref": "mfu-work-result.schema.json" },
                      "artifacts": { "type": "array", "maxItems": 100, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } },
                      "submittedAt": { "$ref": "common.schema.json#/$defs/instant" }
                    }
                  }
                ]
              }
        }
      }
    }
  }
}
