{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hyprial.com/mfu/hyprial-agent-task/v1/agent-task-projection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "externalRef", "state", "targets", "lastEventId"],
  "properties": {
    "runId": { "$ref": "common.schema.json#/$defs/boundedId" },
    "externalRef": { "type": "string", "minLength": 7, "maxLength": 240 },
    "state": { "enum": ["reserved", "running", "waiting", "completed", "failed", "cancelled"] },
    "targets": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": { "$ref": "common.schema.json#/$defs/targetProjection" }
    },
    "lastEventId": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/boundedId" }, { "type": "null" }]
    }
  }
}
