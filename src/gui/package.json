{
  "name": "@hyprial/dsh-h2b-talk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./static/host.js",
  "exports": {
    ".": "./static/host.js",
    "./client": "./static/client.js",
    "./agent-task-client": "./integration/agent-task-client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./dsh-web.patch.yml" },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "update:dsh-release": "npm install --prefix packages/dsh-runtime --save-exact @deepseek-ai/dsh@latest pnpm@11.24.0 --registry=https://registry.npmjs.org --no-audit --no-fund",
    "test:dsh:latest": "node scripts/verify-dsh-latest.mjs",
    "build:dashboard": "npm --prefix dashboard run build",
    "start:dashboard": "node dashboard/server.mjs",
    "dev:dashboard": "npm --prefix dashboard run dev",
    "test:dashboard:ui": "npm --prefix dashboard run test:ui",
    "build:static": "node scripts/build-static-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:cli:real": "node scripts/verify-cli-console.mjs",
    "test:agent-task:real": "node scripts/verify-agent-task-real.mjs",
    "setup:local": "bash scripts/install-local.sh",
    "start:web": "bash scripts/start-web.sh",
    "build:codex": "node scripts/codex-package.mjs build",
    "verify:codex": "node scripts/codex-package.mjs verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.0"
  }
}
