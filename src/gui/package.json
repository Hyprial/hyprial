{
  "name": "@hyprial/gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./studio": "./studio/index.mjs",
    "./session": "./session/index.mjs",
    "./host": "./host/index.mjs",
    "./client": "./client/index.mjs",
