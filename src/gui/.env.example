# Copy this file to .env.local only when the defaults below do not fit the
# machine that actually runs DSH. .env.local is gitignored.

# Kanban paths are normally loaded from ~/.h2b/apps/kanban/env.sh.
# Optional: H2B_KANBAN_ENV_FILE=/absolute/path/to/kanban/env.sh
# Explicit H2B_KANBAN_BRIDGE / H2B_KANBAN_DATA_DIR / H2B_KANBAN_TASK_BIN
# values override the installed configuration. See docs/kanban-gui.md.

DSH_H2B_HOST=127.0.0.1
DSH_H2B_PORT=3080

# Same-machine H2B uses ${H2B_HOME:-$HOME/.h2b}/state/daemon.sock by default.
# For an isolated or forwarded daemon, set the absolute socket path visible to
# the DSH process.
# HARNESS_SOCKET_PATH=/absolute/path/visible/to/dsh/daemon.sock

# Optional worker directory. This path must exist on the machine that actually
# runs the DSH worker.
# H2B_DSH_DEMO_CWD=/absolute/path/on/the/dsh-worker-machine/dsh-hyprial-plugin

# Optional exact, verified identities. Contacts and structured @Agent normally
# obtain session-scoped authorization from the live H2B target registry.
# H2B_DSH_DEMO_ALLOW_FROM=agent:owner:node:agent-name,user:owner

# Set to 1 to prevent DSH from opening a browser automatically.
# DSH_H2B_NO_OPEN=1

# Codex-only proxy; the DSH GUI launcher removes generic proxy variables.
# Login, refresh, HTTP and WebSocket use the isolated Codex worker.
# DSH_CODEX_PROXY=http://127.0.0.1:7890
