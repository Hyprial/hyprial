{
  "version": 1,
  "httpContractVersion": 1,
  "dispatch": {
    "values": [
      "not-dispatched",
      "dispatched",
      "unknown"
    ],
    "outcomeUnknown": [
      "unknown"
    ],
    "rules": [
      "local refusal or daemon connect/restore-gate refusal is not-dispatched",
      "a valid explicit daemon response, including a declared domain error, is dispatched",
      "sent without a valid explicit response is unknown"
    ]
  },
  "headers": {
    "requestId": "X-Hyprial-Request-Id",
    "catalogDigest": "X-Hyprial-Catalog-Digest",
    "authentication": "Authorization: Bearer <server.json token>",
    "corsAllowMethods": "GET, POST, OPTIONS",
    "corsAllowHeaders": "Authorization, Content-Type, X-Hyprial-Catalog-Digest",
    "corsExposeHeaders": "X-Hyprial-Request-Id, X-Hyprial-Catalog-Digest",
    "caseInsensitive": true
  },
  "endpoints": {
    "GET /healthz": {
      "auth": false,
      "body": "{\"ok\":true}"
    },
    "GET /readyz": {
      "auth": true,
      "body": "ready document; 503 when restoring/not-ready"
    },
    "GET /daemon/request": {
      "auth": true,
      "body": "catalog document"
    },
    "GET /openapi.json": {
      "auth": true,
      "body": "OpenAPI 3.1 document for the actual transport routes; per-method schemas mirror daemon.catalog"
    },
    "POST /daemon/request/<method>": {
      "auth": true,
      "body": "JSON object params"
    },
    "OPTIONS /readyz|/daemon/request|/daemon/request/<method>": {
      "auth": false,
      "body": "CORS preflight"
    }
  },
  "successEnvelope": {
    "type": "object",
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "ok": {
        "const": true
      },
      "method": {
        "type": "string",
        "minLength": 1
      },
      "requestId": {
        "type": "string",
        "minLength": 1
      },
      "dispatch": {
        "const": "dispatched"
      },
      "result": {
        "type": "object"
      }
    },
    "required": [
      "schemaVersion",
      "ok",
      "method",
      "requestId",
      "dispatch",
      "result"
    ],
    "additionalProperties": false
  },
  "errorEnvelope": {
    "type": "object",
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "ok": {
        "const": false
      },
      "requestId": {
        "type": "string",
        "minLength": 1
      },
      "code": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "message": {
        "type": "string",
        "maxLength": 512
      },
      "dispatch": {
        "enum": [
          "not-dispatched",
          "dispatched",
          "unknown"
        ]
      },
      "method": {
        "type": "string"
      },
      "data": {
        "type": "object"
      }
    },
    "required": [
      "schemaVersion",
      "ok",
      "requestId",
      "code",
      "message",
      "dispatch"
    ],
    "additionalProperties": false
  },
  "catalog": {
    "type": "object",
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "ok": {
        "const": true
      },
      "httpContractVersion": {
        "const": 1
      },
      "catalogVersion": {
        "const": "1"
      },
      "catalogDigest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "declarationDigest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "generatedFrom": {
        "const": "daemon.catalog"
      },
      "backend": {
        "type": "object"
      },
      "principal": {
        "type": "object"
      },
      "methods": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "required": [
      "schemaVersion",
      "ok",
      "httpContractVersion",
      "catalogVersion",
      "catalogDigest",
      "declarationDigest",
      "generatedFrom",
      "backend",
      "principal",
      "methods"
    ],
    "additionalProperties": false
  },
  "identity": {
    "modes": [
      "none",
      "local-operator-selector"
    ],
    "selectorInjection": "missing selector receives principal.actor",
    "selectorMismatch": "PRINCIPAL_MISMATCH (403), data only {field}",
    "nonStringSelector": "INVALID_ARGUMENT (400) before the selector comparison",
    "unsupportedMode": "method is excluded from the catalog and route"
  },
  "statusByCode": {
    "INVALID_ARGUMENT": 400,
    "INVALID_REQUEST": 400,
    "INVALID_PARAMS": 400,
    "HTTP_HOST_DENIED": 403,
    "HTTP_ORIGIN_DENIED": 403,
    "HTTP_UNAUTHORIZED": 401,
    "METHOD_NOT_FOUND": 404,
    "HTTP_BODY_TOO_LARGE": 413,
    "HTTP_URI_TOO_LONG": 414,
    "HTTP_HEADERS_TOO_LARGE": 431,
    "HTTP_UNSUPPORTED_MEDIA_TYPE": 415,
    "HTTP_METHOD_NOT_ALLOWED": 405,
    "HTTP_BUSY": 429,
    "HTTP_LENGTH_REQUIRED": 411,
    "HTTP_TIMEOUT": 408,
    "HTTP_NOT_READY": 503,
    "HTTP_IDEMPOTENCY_KEY_UNSUPPORTED": 400,
    "HTTP_INTERNAL": 500,
    "PRINCIPAL_MISMATCH": 403,
    "CATALOG_MISMATCH": 409,
    "CATALOG_STALE": 503,
    "VERSION_MISMATCH": 409,
    "DAEMON_UNAVAILABLE": 503,
    "DAEMON_RESTORING": 503,
    "DAEMON_NOT_READY": 503,
    "DAEMON_DISCONNECTED": 503,
    "IPC_TIMEOUT": 504,
    "INVALID_RESPONSE": 502,
    "IPC_RESPONSE_TOO_LARGE": 502,
    "DAEMON_ERROR": 500,
    "CALLER_NOT_AUTHORIZED": 403,
    "SENDER_NOT_AUTHENTICATED": 403,
    "SENDER_UNRESOLVED": 403,
    "TARGET_NOT_AUTHORIZED": 403,
    "CHANNEL_NOT_AUTHORIZED": 403,
    "ORG_CONTEXT_NOT_AUTHORIZED": 403,
    "STALE_SESSION": 403,
    "SESSION_SUPERSEDED": 403,
    "INVALID_SESSION_SOURCE": 403
  },
  "retryableCodes": [
    "DAEMON_DISCONNECTED",
    "DAEMON_NOT_READY",
    "DAEMON_RESTORING",
    "DAEMON_UNAVAILABLE",
    "HTTP_BUSY",
    "HTTP_NOT_READY",
    "INVALID_RESPONSE",
    "IPC_RESPONSE_TOO_LARGE",
    "IPC_TIMEOUT"
  ],
  "retryRules": {
    "serverRetries": false,
    "defaultClientRetries": false,
    "permit": "safe read AND transient code AND not cancelled AND within budget",
    "neverRetry": [
      "CATALOG_MISMATCH",
      "CATALOG_STALE",
      "VERSION_MISMATCH"
    ]
  }
}
