{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyprial.com/contracts/adapters/shared-channel-v1/schema.json",
  "type": "object",
  "required": ["schemaVersion", "caseId", "contract", "expected"],
  "properties": {
    "schemaVersion": {"const": 1},
    "caseId": {"type": "string", "pattern": "^UA-[0-9]{3}:"},
    "contract": {"type": "string", "minLength": 1},
    "expected": {"type": "object"}
  },
  "additionalProperties": false
}
