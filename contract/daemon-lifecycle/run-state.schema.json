{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hyprial additive agent runState",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "baseState", "reason", "certainty", "scope", "sinceMs", "observedAtMs", "turnAgeMs", "lastActivityAtMs", "coverage", "observationHealth", "suspicions", "policyRevision", "providerBlocked", "runtimeIncarnation", "revision", "epoch", "lastKnown", "thresholds"],
  "properties": {
    "state": {"type":"string", "enum":["starting","idle","in-turn","blocked","suspected-stuck","stopping","not-running","unknown"]},
    "baseState": {"type":"string", "enum":["starting","idle","in-turn","stopping","not-running","unknown"]},
    "reason": {"type":"string", "enum":["source-unavailable","process-exited","start-pending","stop-pending","carrier-stale","conflicting-facts","observation-gap","partial-turn-coverage","permission-wait","provider-block","turn-over-budget","producer-quiet","turn-open","no-open-turn"]},
    "certainty": {"type":"string", "enum":["observed","inferred","unknown"]},
    "scope": {"type":"string", "enum":["whole-session","carrier-deliveries"]},
    "sinceMs": {"type":["integer","null"]},
    "observedAtMs": {"type":"integer"},
    "turnAgeMs": {"type":["integer","null"],"minimum":0},
    "lastActivityAtMs": {"type":["integer","null"]},
    "coverage": {"type":"object", "additionalProperties":false,
      "required":["turnBoundaries","permissionWait","producerActivity","processExit"],
      "properties":{"turnBoundaries":{"type":"boolean"},"permissionWait":{"type":"boolean"},"producerActivity":{"type":"boolean"},"processExit":{"type":"boolean"}}},
    "observationHealth": {"type":"string", "enum":["current","stale","unavailable","partial","resync-required"]},
    "suspicions": {"type":"array", "items":{"type":"string","enum":["turn-over-budget","producer-quiet","permission-wait-long"]}},
    "policyRevision": {"type":"integer", "minimum":1},
    "providerBlocked": {"type":"boolean"},
    "runtimeIncarnation": {"type":"string"},
    "revision": {"type":"integer", "minimum":1},
    "epoch": {"type":"string"},
    "lastKnown": {"type":["object","null"], "additionalProperties":false,
      "required":["state","baseState","sinceMs","observedAtMs","runtimeIncarnation"],
      "properties":{"state":{"type":"string"},"baseState":{"type":"string"},"sinceMs":{"type":["integer","null"]},"observedAtMs":{"type":"integer"},"runtimeIncarnation":{"type":"string"}}},
    "thresholds": {"type":"object", "additionalProperties":false,
      "required":["turnLongAfterMs","permissionLongAfterMs","quietAfterMs"],
      "properties":{"turnLongAfterMs":{"type":["integer","null"],"minimum":1},"permissionLongAfterMs":{"type":["integer","null"],"minimum":1},"quietAfterMs":{"type":["integer","null"],"minimum":1}}}
  }
}
