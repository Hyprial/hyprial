{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyprial.com/hyprial/trajectory.schema.json",
  "title": "hyprial message trajectory response",
  "type": "object",
  "required": [
    "schemaVersion",
    "ok",
    "found",
    "messageId",
    "nodes",
    "agentTimeline",
    "skippedLines",
    "ordering"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "ok": {"const": true},
    "found": {"type": "boolean"},
    "messageId": {"type": "string", "minLength": 1},
    "message": {"type": "string"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ts",
          "node",
          "component",
          "name",
          "event",
          "state",
          "messageId",
          "correlationId",
          "source",
          "details"
        ],
        "properties": {
          "ts": {"type": ["string", "null"], "format": "date-time"},
          "node": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "event": {"type": "string", "minLength": 1},
          "state": {"enum": ["completed", "unknown", "running"]},
          "messageId": {"type": "string", "minLength": 1},
          "correlationId": {"type": "string", "minLength": 1},
          "source": {"enum": ["log", "message-status"]},
          "details": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "agentTimeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ts", "level", "component", "name", "event"],
        "properties": {
          "ts": {"type": "string", "format": "date-time"},
          "level": {"enum": ["debug", "info", "warn", "error"]},
          "component": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "event": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "skippedLines": {"type": "integer", "minimum": 0},
    "ordering": {
      "type": "object",
      "required": ["key", "authoritative", "detail"],
      "properties": {
        "key": {"const": "ts"},
        "authoritative": {"const": false},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
