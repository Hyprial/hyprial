{
  "id": "R5",
  "title": "Turning the wait off after a list (the client became busy) paces the next list by the interval",
  "steps": [
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "register"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1"
        }
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "list"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            }
          ]
        }
      },
      "emit": {
        "new": [
          "m1"
        ]
      }
    },
    {
      "lane": "poll",
      "useWait": false
    },
    {
      "lane": "poll",
      "expect": {
        "op": "sleep",
        "ms": 500
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "list"
      },
      "at": 500
    },
    {
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            }
          ]
        }
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "sleep",
        "ms": 500
      }
    },
    {
      "at": 600,
      "lane": "poll",
      "useWait": true
    },
    {
      "lane": "poll",
      "expect": {
        "op": "sleep",
        "ms": 400
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "list"
      },
      "at": 1000
    },
    {
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            }
          ]
        }
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "wait",
        "knownMessageIds": [
          "m1"
        ]
      }
    }
  ],
  "counters": {
    "wait.unheld": 0
  }
}
