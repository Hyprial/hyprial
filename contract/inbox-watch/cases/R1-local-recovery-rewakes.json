{
  "id": "R1",
  "title": "A client recovery pulse (session start, failed turn) re-wakes on the next list",
  "steps": [
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "register"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1"
        }
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "list"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            }
          ]
        }
      },
      "emit": {
        "new": [
          "m1"
        ]
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "wait",
        "knownMessageIds": [
          "m1"
        ]
      }
    },
    {
      "at": 300,
      "lane": "poll",
      "rewake": "recovery"
    },
    {
      "lane": "poll",
      "at": 5000,
      "respond": {
        "ok": {
          "ok": true,
          "changed": false,
          "held": true,
          "daemonEpoch": "e1"
        }
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "list"
      }
    },
    {
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            }
          ]
        }
      },
      "emit": {
        "rewake": [
          "m1"
        ],
        "rewakeReason": "recovery"
      }
    }
  ]
}
