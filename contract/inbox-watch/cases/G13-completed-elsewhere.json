{
  "id": "G13",
  "title": "A message settled elsewhere is reported completed, never delivered again",
  "steps": [
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "register"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1"
        }
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "list"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            }
          ]
        }
      },
      "emit": {
        "new": [
          "m1"
        ]
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "wait",
        "knownMessageIds": [
          "m1"
        ]
      }
    },
    {
      "lane": "poll",
      "at": 900,
      "respond": {
        "ok": {
          "ok": true,
          "changed": true,
          "held": true,
          "daemonEpoch": "e1"
        }
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "list"
      }
    },
    {
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1",
          "messages": [
            {
              "deliveryId": "no-message-id"
            }
          ]
        }
      },
      "emit": {
        "completed": [
          "m1"
        ]
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "wait",
        "knownMessageIds": []
      }
    }
  ],
  "counters": {
    "deliver.invalid": 1
  }
}
