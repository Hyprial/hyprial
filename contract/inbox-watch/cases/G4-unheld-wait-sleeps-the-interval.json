{
  "id": "G4",
  "title": "A wait that did not hold (unseen message, capacity full) never spins",
  "steps": [
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "register"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1"
        }
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "list"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            }
          ]
        }
      },
      "emit": {
        "new": [
          "m1"
        ]
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "wait",
        "knownMessageIds": [
          "m1"
        ]
      }
    },
    {
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "changed": false,
          "held": false,
          "daemonEpoch": "e1"
        }
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "sleep",
        "ms": 500
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "list"
      },
      "at": 500
    }
  ],
  "counters": {
    "wait.unheld": 1
  }
}
