{
  "id": "G8d",
  "title": "While one lane refreshes, the other never issues a second refresh",
  "steps": [
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "register"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1"
        }
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "list"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            }
          ]
        }
      },
      "emit": {
        "new": [
          "m1"
        ]
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "wait",
        "knownMessageIds": [
          "m1"
        ]
      }
    },
    {
      "lane": "poll",
      "at": 100,
      "respond": {
        "ok": {
          "ok": true,
          "changed": true,
          "held": true,
          "daemonEpoch": "e2"
        }
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "refresh"
      }
    },
    {
      "lane": "heartbeat",
      "expect": {
        "op": "heartbeat"
      },
      "at": 1000
    },
    {
      "lane": "heartbeat",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e2"
        }
      }
    },
    {
      "lane": "heartbeat",
      "expect": {
        "op": "sleep",
        "ms": 1000
      }
    },
    {
      "lane": "poll",
      "at": 1100,
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e2"
        }
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "list"
      }
    },
    {
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e2",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            }
          ]
        }
      },
      "emit": {
        "rewake": [
          "m1"
        ],
        "rewakeReason": "epoch"
      }
    }
  ]
}
