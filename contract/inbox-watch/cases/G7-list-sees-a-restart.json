{
  "id": "G7",
  "title": "A list that sees a new daemon epoch refreshes, then re-wakes the whole backlog",
  "steps": [
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "register"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1"
        }
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "list"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            }
          ]
        }
      },
      "emit": {
        "new": [
          "m1"
        ]
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "wait",
        "knownMessageIds": [
          "m1"
        ]
      }
    },
    {
      "lane": "poll",
      "at": 300,
      "respond": {
        "unreachable": true
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "sleep",
        "ms": 500
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "list"
      },
      "at": 800
    },
    {
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e2",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            },
            {
              "messageId": "m2",
              "deliveryId": "m2"
            }
          ]
        }
      },
      "emit": {
        "new": [
          "m2"
        ]
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "refresh"
      }
    },
    {
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e2"
        }
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "list"
      }
    },
    {
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e2",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            },
            {
              "messageId": "m2",
              "deliveryId": "m2"
            }
          ]
        }
      },
      "emit": {
        "rewake": [
          "m1",
          "m2"
        ],
        "rewakeReason": "epoch"
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "wait",
        "knownMessageIds": [
          "m1",
          "m2"
        ]
      }
    }
  ],
  "counters": {
    "rewake.epoch": 1
  }
}
