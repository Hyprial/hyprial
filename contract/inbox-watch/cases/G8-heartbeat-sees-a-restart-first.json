{
  "id": "G8",
  "title": "When the heartbeat sees the new epoch first, the next list still re-wakes",
  "steps": [
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "register"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1"
        }
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "expect": {
        "op": "list"
      }
    },
    {
      "at": 0,
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e1",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            }
          ]
        }
      },
      "emit": {
        "new": [
          "m1"
        ]
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "wait",
        "knownMessageIds": [
          "m1"
        ]
      }
    },
    {
      "lane": "heartbeat",
      "expect": {
        "op": "heartbeat"
      },
      "at": 1000
    },
    {
      "lane": "heartbeat",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e2"
        }
      }
    },
    {
      "lane": "heartbeat",
      "expect": {
        "op": "refresh"
      }
    },
    {
      "lane": "heartbeat",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e2"
        }
      }
    },
    {
      "lane": "heartbeat",
      "expect": {
        "op": "sleep",
        "ms": 1000
      }
    },
    {
      "lane": "poll",
      "at": 5000,
      "respond": {
        "ok": {
          "ok": true,
          "changed": false,
          "held": true,
          "daemonEpoch": "e2"
        }
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "list"
      }
    },
    {
      "lane": "poll",
      "respond": {
        "ok": {
          "ok": true,
          "daemonEpoch": "e2",
          "messages": [
            {
              "messageId": "m1",
              "deliveryId": "m1"
            }
          ]
        }
      },
      "emit": {
        "rewake": [
          "m1"
        ],
        "rewakeReason": "epoch"
      }
    },
    {
      "lane": "poll",
      "expect": {
        "op": "wait",
        "knownMessageIds": [
          "m1"
        ]
      }
    }
  ],
  "counters": {
    "rewake.epoch": 1,
    "wait.held_timeout": 1
  }
}
