 )
 
+type ProxyConnectError struct {
+	StatusCode int
+}
+
+func (e *ProxyConnectError) Error() string {
+	return fmt.Sprintf("proxy CONNECT rejected with status %d", e.StatusCode)
+}
+
+type ProxyRegionError struct {
+	StatusCodes []int
+}
+
+func (e *ProxyRegionError) Error() string {
+	return fmt.Sprintf("all regional proxy CONNECT requests rejected: %v", e.StatusCodes)
+}
+
+type proxyRejectionScope struct {
+	client key.NodePublic
+	region [32]byte
+}
+
+type proxyRejectionSubscription struct {
+	result chan *ProxyRegionError
+	active bool
+}
+
+var proxyRejectionSubscriptions = struct {
+	sync.Mutex
+	entries map[proxyRejectionScope]map[*proxyRejectionSubscription]bool
+}{entries: make(map[proxyRejectionScope]map[*proxyRejectionSubscription]bool)}
+
+func proxyScope(client key.NodePublic, region *tailcfg.DERPRegion) proxyRejectionScope {
+	encoded, _ := json.Marshal(struct {
+		ID    tailcfg.DERPRegionID
+		Nodes []*tailcfg.DERPNode
+	}{region.RegionID, region.Nodes})
+	return proxyRejectionScope{client, sha256.Sum256(encoded)}
+}
+
+func SubscribeProxyRejections(client key.NodePublic, region *tailcfg.DERPRegion) (<-chan *ProxyRegionError, func()) {
+	if client.IsZero() || region == nil {
+		return nil, func() {}
+	}
+	scope := proxyScope(client, region)
+	sub := &proxyRejectionSubscription{result: make(chan *ProxyRegionError, 1), active: true}
+	registry := &proxyRejectionSubscriptions
+	registry.Lock()
+	if registry.entries[scope] == nil {
+		registry.entries[scope] = make(map[*proxyRejectionSubscription]bool)
+	}
+	registry.entries[scope][sub] = true
+	registry.Unlock()
+	return sub.result, func() {
+		registry.Lock()
+		defer registry.Unlock()
+		sub.active = false
+		delete(registry.entries[scope], sub)
+		if len(registry.entries[scope]) == 0 {
+			delete(registry.entries, scope)
+		}
+	}
+}
+
+func (c *Client) proxyRejectionWaiters(region *tailcfg.DERPRegion) []*proxyRejectionSubscription {
+	if c.IsProber || c.privateKey.IsZero() {
+		return nil
+	}
+	registry := &proxyRejectionSubscriptions
+	registry.Lock()
+	defer registry.Unlock()
+	var result []*proxyRejectionSubscription
+	for sub := range registry.entries[proxyScope(c.privateKey.Public(), region)] {
+		result = append(result, sub)
+	}
+	return result
+}
+
+func publishProxyRejection(waiters []*proxyRejectionSubscription, statuses []int) {
+	registry := &proxyRejectionSubscriptions
+	registry.Lock()
+	defer registry.Unlock()
+	for _, sub := range waiters {
+		if sub.active {
+			select {
+			case sub.result <- &ProxyRegionError{StatusCodes: append([]int(nil), statuses...)}:
+			default:
+			}
+		}
+	}
+}
+
