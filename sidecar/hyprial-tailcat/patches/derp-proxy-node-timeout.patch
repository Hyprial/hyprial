+func TestProxyDialNodeDeadline(t *testing.T) {
+	for _, mode := range []string{"response-timeout", "parent-cancel", "connected"} {
+		t.Run(mode, func(t *testing.T) {
+			proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				conn, _, err := w.(http.Hijacker).Hijack()
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				defer conn.Close()
+				conn.SetDeadline(time.Now().Add(10 * time.Second))
+				if mode == "connected" {
+					io.WriteString(conn, "HTTP/1.1 200 Connection Established\r\n\r\n")
+					io.Copy(conn, conn)
+				} else {
+					io.Copy(io.Discard, conn)
+				}
+			}))
+			defer proxy.Close()
+			proxyURL, err := url.Parse(proxy.URL)
+			if err != nil {
+				t.Fatal(err)
+			}
+			budget := 6 * time.Second
+			if mode == "parent-cancel" {
+				budget = 100 * time.Millisecond
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), budget)
+			defer cancel()
+			client := &Client{logf: t.Logf}
+			node := &tailcfg.DERPNode{HostName: "relay.invalid", DERPPort: 443}
+			started := time.Now()
+			conn, err := client.dialNodeUsingProxy(ctx, node, proxyURL)
+			elapsed := time.Since(started)
+			if mode == "connected" {
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer conn.Close()
+				timer := time.NewTimer(dialNodeTimeout + 300*time.Millisecond)
+				defer timer.Stop()
+				select {
+				case <-timer.C:
+				case <-ctx.Done():
+					t.Fatal(ctx.Err())
+				}
+				conn.SetDeadline(time.Now().Add(time.Second))
+				if _, err := io.WriteString(conn, "x"); err != nil {
+					t.Fatal(err)
+				}
+				var reply [1]byte
+				if _, err := io.ReadFull(conn, reply[:]); err != nil || reply[0] != 'x' {
+					t.Fatalf("successful tunnel did not survive dial cancellation: %v", err)
+				}
+				return
+			}
+			if conn != nil {
+				conn.Close()
+			}
+			if err == nil {
+				t.Fatal("hung CONNECT succeeded")
+			}
+			limit := dialNodeTimeout + time.Second
+			if mode == "parent-cancel" {
+				limit = time.Second
+			}
+			if elapsed > limit {
+				t.Fatalf("deadline ignored: %s > %s", elapsed, limit)
+			}
+		})
+	}
+}
+
+func TestProxyDialTLSDeadline(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		conn, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		conn.SetDeadline(time.Now().Add(8 * time.Second))
+		io.Copy(io.Discard, conn)
+	}()
+	ctx, cancel := context.WithTimeout(context.Background(), 6*time.Second)
+	defer cancel()
+	client := &Client{logf: t.Logf}
+	started := time.Now()
+	conn, err := client.dialNodeUsingProxy(ctx, &tailcfg.DERPNode{HostName: "relay.invalid"}, &url.URL{Scheme: "https", Host: ln.Addr().String()})
+	if conn != nil {
+		conn.Close()
+	}
+	if err == nil || time.Since(started) > dialNodeTimeout+time.Second {
+		t.Fatalf("proxy TLS ignored node deadline: %v after %s", err, time.Since(started))
+	}
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("proxy connection not closed")
+	}
+}
+
+func TestProxyRegionRejection(t *testing.T) {
+	for _, status := range []int{403, 407, 503} {
+		for _, healthy := range []bool{false, true} {
+			proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if healthy && r.Host == "healthy.invalid:443" {
+					w.WriteHeader(200)
+				} else {
+					w.WriteHeader(status)
+				}
+			}))
+			proxyURL, _ := url.Parse(proxy.URL)
+			restore := feature.HookProxyFromEnvironment.SetForTest(func(*http.Request) (*url.URL, error) { return proxyURL, nil })
+			region := &tailcfg.DERPRegion{RegionID: 1, Nodes: []*tailcfg.DERPNode{{HostName: "blocked.invalid"}, {HostName: "healthy.invalid"}}}
+			k := key.NewNode()
+			ch, stop := SubscribeProxyRejections(k.Public(), region)
+			client := &Client{privateKey: k, logf: t.Logf}
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			started := time.Now()
+			conn, _, err := client.dialRegion(ctx, region)
+			cancel()
+			if conn != nil {
+				conn.Close()
+			}
+			if time.Since(started) > 500*time.Millisecond {
+				t.Error("proxy rejection was not prompt")
+			}
+			if healthy {
+				if err != nil {
+					t.Errorf("healthy later node rejected: %v", err)
+				}
+				select {
+				case <-ch:
+					t.Error("notified before healthy later node")
+				default:
+				}
+			} else {
+				var rejection *ProxyRegionError
+				if !errors.As(err, &rejection) {
+					t.Errorf("not a typed regional rejection: %v", err)
+				}
+				select {
+				case event := <-ch:
+					if len(event.StatusCodes) != 2 || event.StatusCodes[0] != status || event.StatusCodes[1] != status {
+						t.Errorf("wrong statuses: %v", event)
+					}
+				default:
+					t.Error("missing actual region-exhaustion notification")
+				}
+			}
+			stop()
+			restore()
+			proxy.Close()
+		}
+	}
+}
+
+func TestProxyRejectionLateGeneration(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	entered, release := make(chan struct{}, 1), make(chan struct{})
+	releaseNow := sync.OnceFunc(func() { close(release) })
+	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		entered <- struct{}{}
+		select {
+		case <-release:
+			w.WriteHeader(403)
+		case <-ctx.Done():
+		}
+	}))
+	defer proxy.Close()
+	defer releaseNow()
+	proxyURL, _ := url.Parse(proxy.URL)
+	restore := feature.HookProxyFromEnvironment.SetForTest(func(*http.Request) (*url.URL, error) { return proxyURL, nil })
+	defer restore()
+	region := &tailcfg.DERPRegion{RegionID: 1, Nodes: []*tailcfg.DERPNode{{HostName: "blocked.invalid"}}}
+	k := key.NewNode()
+	old, stopOld := SubscribeProxyRejections(k.Public(), region)
+	defer stopOld()
+	finished := make(chan error, 1)
+	go func() {
+		client := &Client{privateKey: k, logf: t.Logf}
+		_, _, err := client.dialRegion(ctx, region)
+		finished <- err
+	}()
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	stopOld()
+	current, stopCurrent := SubscribeProxyRejections(k.Public(), region)
+	defer stopCurrent()
+	releaseNow()
+	select {
+	case err := <-finished:
+		if err == nil {
+			t.Fatal("expected rejection")
+		}
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	for _, ch := range []<-chan *ProxyRegionError{old, current} {
+		select {
+		case <-ch:
+			t.Error("late dial notified a cancelled or later Ping generation")
+		default:
+		}
+	}
+}
+
+func TestProxyRejectionConcurrentSubscriptions(t *testing.T) {
+	region := &tailcfg.DERPRegion{RegionID: 1, Nodes: []*tailcfg.DERPNode{{HostName: "blocked.invalid"}}}
+	client := &Client{privateKey: key.NewNode()}
+	var wg sync.WaitGroup
+	for range 100 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, stop := SubscribeProxyRejections(client.privateKey.Public(), region)
+			waiters := client.proxyRejectionWaiters(region)
+			stop()
+			publishProxyRejection(waiters, []int{403})
+		}()
+	}
+	finished := make(chan struct{})
+	go func() { wg.Wait(); close(finished) }()
+	select {
+	case <-finished:
+	case <-time.After(3 * time.Second):
+		t.Fatal("subscription cleanup blocked")
+	}
+	proxyRejectionSubscriptions.Lock()
+	defer proxyRejectionSubscriptions.Unlock()
+	if len(proxyRejectionSubscriptions.entries) != 0 {
+		t.Error("concurrent subscriptions leaked")
+	}
+}
+
+func TestProxyRejectionSubscriptionScope(t *testing.T) {
+	region := &tailcfg.DERPRegion{RegionID: 1, Nodes: []*tailcfg.DERPNode{{HostName: "relay.invalid"}}}
+	other := &tailcfg.DERPRegion{RegionID: 1, Nodes: []*tailcfg.DERPNode{{HostName: "other.invalid"}}}
+	k := key.NewNode()
+	first, stopFirst := SubscribeProxyRejections(k.Public(), region)
+	unrelated, stopUnrelated := SubscribeProxyRejections(key.NewNode().Public(), region)
+	otherRegion, stopOther := SubscribeProxyRejections(k.Public(), other)
+	client := &Client{privateKey: k}
+	old := client.proxyRejectionWaiters(region)
+	stopFirst()
+	second, stopSecond := SubscribeProxyRejections(k.Public(), region)
+	stopFirst()
+	publishProxyRejection(old, []int{403})
+	client.IsProber = true
+	publishProxyRejection(client.proxyRejectionWaiters(region), []int{403})
+	for _, ch := range []<-chan *ProxyRegionError{first, second, unrelated, otherRegion} {
+		select {
+		case <-ch:
+			t.Error("stale, probe, or unrelated notification")
+		default:
+		}
+	}
+	client.IsProber = false
+	publishProxyRejection(client.proxyRejectionWaiters(region), []int{407})
+	select {
+	case <-second:
+	default:
+		t.Error("active generation not notified")
+	}
+	stopSecond()
+	stopUnrelated()
+	stopOther()
+	proxyRejectionSubscriptions.Lock()
+	defer proxyRejectionSubscriptions.Unlock()
+	if len(proxyRejectionSubscriptions.entries) != 0 {
+		t.Error("subscription leaked")
+	}
+}
